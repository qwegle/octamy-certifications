{
  "expo": {
    "name": "Octamy",
    "slug": "octamy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "octamy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.octamy.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Octamy uses the camera only when you choose to record a private interview or profile-practice video on this device.",
        "NSMicrophoneUsageDescription": "Octamy uses the microphone only when you choose to record private practice video.",
        "NSPhotoLibraryUsageDescription": "Octamy does not request photo-library access in this release; private interview recordings remain in app storage."
      }
    },
    "android": {
      "package": "com.octamy.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FCFBF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F2",
          "dark": {
            "backgroundColor": "#090909",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Octamy uses the camera only when you choose to record a private interview or profile-practice video on this device.",
          "microphonePermission": "Octamy uses the microphone only when you choose to record private practice video on this device.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Octamy uses the microphone only when you choose to record private practice video on this device.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
