# Database Configuration
DATABASE_URL="postgresql://octamy_user:your_secure_password@localhost:5432/octamy_dev"
# Tests truncate every table. This must be a separate disposable database.
TEST_DATABASE_URL="postgresql://octamy_user:your_secure_password@localhost:5432/octamy_test"
PGHOST=localhost
PGPORT=5432
PGUSER=octamy_user
PGPASSWORD=your_secure_password
PGDATABASE=octamy_dev

# Application Configuration
NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
# Optional separate HMAC secret for stable public evidence-passport links.
# Falls back to JWT_SECRET. Rotating it invalidates existing share links.
EVIDENCE_LINK_SECRET=your_evidence_link_secret_here_minimum_32_characters
APP_URL=http://localhost:5000

# Google OAuth — create a Web application in Google Cloud and register:
# ${APP_URL}/api/auth/google/user/callback
# ${APP_URL}/api/auth/google/seller/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Payment gateways. Production deploy accepts only "cashfree" or "payu" and
# requires the selected gateway's complete real credential set.
PAYMENT_DEFAULT_GATEWAY=cashfree
# Separate HMAC key for short-lived public payment-status polling tokens.
# Production requires 24+ characters and rejects reuse of JWT_SECRET.
PAYMENT_STATUS_SECRET=your_distinct_payment_status_secret_minimum_32_characters

# Cashfree: keep sandbox locally; production deploy requires CASHFREE_ENV=production.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_sandbox_app_id
CASHFREE_SECRET_KEY=your_cashfree_sandbox_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_sandbox_webhook_secret

# Required instead when PAYMENT_DEFAULT_GATEWAY=payu.
PAYUMONEY_MERCHANT_ID=your_test_merchant_id
PAYUMONEY_MERCHANT_KEY=your_test_merchant_key
PAYUMONEY_SALT=your_test_salt

# Session Configuration
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# Email Configuration (Optional for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=support@octamy.com

# Admin Credentials — REQUIRED in production. Seed will fail without them.
ADMIN_EMAIL=admin@octamy.com
ADMIN_PASSWORD=CHANGE_ME_to_a_strong_password_min_12_chars

# Redis Cache (Optional for development)
REDIS_URL=redis://localhost:6379

# File Upload (Optional)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
# Production media library storage. Development falls back to local disk;
# production uploads are rejected until these are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Revenue allocation on paid digital products (credential activation and course
# access; shipping excluded). Affiliate commission, when present, comes from
# the remaining platform share.
CREATOR_REVENUE_SHARE_PERCENT=80
INSTITUTE_REVENUE_SHARE_PERCENT=80

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Profile approval — set to "false" in production to require admin approval of
# creators / institutes / recruiters before they can publish or buy credits.
AUTO_APPROVE_PROFILES=false

# AI-assisted course drafting (optional). The API stays disabled and manual
# course creation remains available until a real server-side key is supplied.
# Never expose this value through a VITE_ variable or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Interview Studio — private practice can run without providers and will never
# invent scores. AI feedback/voice require OPENAI_API_KEY. Candidate code must
# execute in a separately operated Judge0-compatible sandbox; never point this
# at the Octamy web process or expose its token to Vite/browser variables.
INTERVIEW_STUDIO_ENABLED=true
OPENAI_INTERVIEW_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
INTERVIEW_STUDIO_DAILY_EVALUATION_LIMIT=10
INTERVIEW_STUDIO_DAILY_RUNNER_LIMIT=10
INTERVIEW_STUDIO_MAX_QUEUE_LAG_SECONDS=900
INTERVIEW_STUDIO_EVALUATION_WORKER_ENABLED=true
INTERVIEW_STUDIO_EVALUATION_MAX_ATTEMPTS=3
INTERVIEW_STUDIO_EVALUATION_CONCURRENCY=1
INTERVIEW_STUDIO_EVALUATION_LEASE_MS=300000
INTERVIEW_STUDIO_EVALUATION_CANCELLATION_POLL_MS=2000
INTERVIEW_STUDIO_RETENTION_WORKER_ENABLED=true
INTERVIEW_STUDIO_RETENTION_INTERVAL_MS=3600000
INTERVIEW_STUDIO_RETENTION_BATCH_SIZE=250
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
CODE_RUNNER_TOKEN_HEADER=X-Auth-Token
CODE_RUNNER_JAVASCRIPT_LANGUAGE_ID=63
CODE_RUNNER_VERSION=node20-isolated-v1
CODE_RUNNER_TIMEOUT_MS=8000
CODE_RUNNER_CPU_TIME_SECONDS=2
CODE_RUNNER_WALL_TIME_SECONDS=5
CODE_RUNNER_MEMORY_KB=131072
# Verified recruiter evidence remains disabled until private media, human
# review, consented sharing and the corresponding APIs are fully released.
INTERVIEW_HUMAN_REVIEW_ENABLED=false
INTERVIEW_VERIFIED_SHARING_ENABLED=false

# Security
BCRYPT_ROUNDS=12
# Comma-separated list of allowed cross-origin sites; leave blank to allow same-origin only.
CORS_ORIGIN=https://octamy.com,https://www.octamy.com

# Optional public company / certification references. Leave blank unless each
# value can be independently verified; the trust page will not claim ISO status
# without a configured standard and certificate number.
VITE_COMPANY_CIN=
VITE_COMPANY_GSTIN=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_ISO_STANDARD=
VITE_COMPANY_ISO_NUMBER=
VITE_COMPANY_ISO_SCOPE=
